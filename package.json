{
	"name": "r2-webdav",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "wrangler dev --local --host localhost",
		"start": "wrangler dev --local --host localhost",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"types": "wrangler types",
		"typecheck": "tsc --noEmit",
		"build": "wrangler deploy --dry-run --outdir dist",
		"test": "npm run build && node --test tests/regression.test.mjs",
		"test:protocol": "node tests/protocol.mjs"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "5.20261103.1",
		"@types/node": "26.6.6",
		"prettier": "3.9.10",
		"typescript": "7.0.2",
		"wrangler": "4.156.2"
	},
	"type": "module",
	"dependencies": {
		"@xmldom/xmldom": "^0.8.11"
	}
}
